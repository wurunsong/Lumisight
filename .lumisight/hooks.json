{
  "$schema": "https://codeflicker.ai/schemas/config.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "cat|ls|grep|compileJava|gitDiff",
        "hooks": [
          {
            "type": "command",
            "command": ".lumisight/hooks/test-hook.js"
          }
        ]
      }
    ],
    "BeforeFinal": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".lumisight/hooks/test-hook.js"
          }
        ]
      }
    ],
    "OnError": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".lumisight/hooks/test-hook.js"
          }
        ]
      }
    ]
  }
}
