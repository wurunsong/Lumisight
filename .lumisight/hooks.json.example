{
  "$schema": "https://codeflicker.ai/schemas/config.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "cat|ls|grep|compileJava|gitDiff",
        "hooks": [
          {
            "type": "command",
            "command": ".lumisight/hooks/db-guard-hook.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "cat|ls|grep|compileJava|gitDiff",
        "hooks": [
          {
            "type": "command",
            "command": ".lumisight/hooks/db-guard-hook.js"
          }
        ]
      }
    ],
    "BeforePlan": [],
    "AfterPlan": [],
    "BeforeDecision": [],
    "AfterDecision": [],
    "OnAskUser": [],
    "BeforeFinal": [],
    "OnError": []
  }
}
